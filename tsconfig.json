{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		// the 20 MB non-TS program limit switches the TS service off silently (core 37b3c6ce, showhide-v8-build)
		"disableSizeLimit": true,
		// sk3: `$lib` is our own alias (vite.config.ts resolve.alias); SvelteKit 3 no longer generates it
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		}
	},
	// the set SvelteKit 2's generated tsconfig included, glob for glob (a bare "tests" would pull in every
	// tests/e2e/*.cjs and 55k errors with it)
	"include": [
		"vite.config.js",
		"vite.config.ts",
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte",
		"test/**/*.js",
		"test/**/*.ts",
		"test/**/*.svelte",
		"tests/**/*.js",
		"tests/**/*.ts",
		"tests/**/*.svelte"
	],
	"exclude": ["node_modules", "src/service-worker"]
}
