# Self-hosted PeerJS signaling + TURN (see docs/tf).
# Copy to `.env` and fill in. `.env` is gitignored; Vite inlines VITE_* at BUILD
# time, so these values end up in the shipped bundle (the TURN credential is not
# a secret from the client — see docs/tf/NOTES.md). Leave blank to ship with only
# the public PeerJS cloud (the app still works; "default" mode just = public).

# Signaling server (Caddy terminates TLS in front of PeerServer).
# BLANK ON PURPOSE: filling this in points every build you make at somebody ELSE's
# box. Put your own host here, or leave it empty to use the public PeerJS cloud.
VITE_PEER_HOST=
VITE_PEER_PORT=443
VITE_PEER_PATH=/peerjs
VITE_PEER_SECURE=true
# VITE_PEER_KEY=            # only if the server sets a non-default --key

# ICE: comma-separated URLs. STUN is free/anonymous; TURN needs the credential.
VITE_STUN_URLS=stun:your-peerjs-host.example:3478
VITE_TURN_URLS=turn:your-peerjs-host.example:3478?transport=udp,turn:your-peerjs-host.example:3478?transport=tcp
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# CORS proxy chain for generated-asset CDNs that send no Access-Control-Allow-Origin
# (Meshy GLB downloads). Primary = the Cloudflare Worker (infra repo worker/,
# free tier, EC2-independent); the app automatically falls back to
# https://<VITE_PEER_HOST>/proxy (the peerjs box route) if the Worker is gone or
# over quota, and the DEV server serves its own same-origin /proxy.
VITE_ASSET_PROXY=https://proxy.theprototype.app

# --- local development conveniences -----------------------------------------
# Skip the first-run welcome overlay entirely. For a dev server you open fifty
# times a day; it changes nothing about what ships.
VITE_SKIP_WELCOME=false

# 34 R1: performance reports (opt-in "Send performance reports"). The PocketBase
# perf_reports create URL; absent = the feature does not exist (no setting, no offer).
# VITE_PERF_REPORTS_URL=https://pb.theprototype.app/api/collections/perf_reports/records?fields=id
# Preview builds offer it once; '1'/'0' overrides the host rule (*.theprototype.pages.dev = preview).
# VITE_PERF_REPORTS_OFFER=

# 48 O1 / 49 J3: error reports. The Worker endpoint (absent = no reports). A preview files its
# reports under its own release: the `preview-<major>-<minor>` alias it is served on, else
# `<package version>-preview`; set VITE_RELEASE_LABEL (≤ 24 chars) to name it explicitly.
# VITE_ERROR_REPORTS_URL=
# VITE_RELEASE_LABEL=

# 69 T3: Content-Security-Policy for BUILDS (`npm run dev` sends none). The policy is written into
# every page as a <meta> (see csp.config.js) and `frame-ancestors` into build/_headers (Cloudflare
# Pages reads it; another server should send that header line itself). All optional:
# VITE_CSP_SCRIPT_SRC=            # extra script origins, e.g. https://static.cloudflareinsights.com
# VITE_CSP_CONNECT_SRC=           # REPLACES the default connect-src ('self' https: wss: + localhost)
# VITE_CSP_EXTRA_CONNECT=         # added to the default connect-src
# VITE_CSP_IMG_SRC=               # REPLACES the default img-src / media-src ('self' data: blob: https:)
# VITE_CSP_FRAME_ANCESTORS=       # who may frame the app (default * — see VITE_PLAY_ORIGIN)
# VITE_CSP=off                    # ship no policy (a deployment that sets its own at the edge)

# 69 T4: an optional second origin for PLAYING (same build, served twice). Play links and embeds point
# there; storage is per origin, so a played scene's page holds none of the editor's (login, AI keys,
# autosaves). On that origin the page is player-only. Unset = one origin for everything (as before).
# VITE_PLAY_ORIGIN=https://play.example.com
# VITE_APP_ORIGIN=https://app.example.com     # where the player's "Open in the app" link goes
