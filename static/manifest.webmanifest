{
	"name": "theprototype.app — collaborative 3D prototyping",
	"short_name": "theprototype",
	"description": "Build 3D scenes together in the browser — peer-to-peer, VR-ready.",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"orientation": "any",
	"background_color": "#111827",
	"theme_color": "#111827",
	"categories": ["productivity", "graphics", "developer"],
	"share_target": {
		"action": "/share-target",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"title": "title",
			"text": "text",
			"url": "url",
			"files": [
				{
					"name": "files",
					"accept": ["image/*", "model/gltf-binary", "model/gltf+json", "application/x-tpscene", ".glb", ".gltf", ".tpscene"]
				}
			]
		}
	},
	"file_handlers": [
		{
			"action": "/",
			"accept": {
				"application/x-tpscene": [".tpscene"],
				"model/gltf-binary": [".glb"],
				"model/gltf+json": [".gltf"]
			}
		}
	],
	"launch_handler": { "client_mode": ["focus-existing", "auto"] },
	"icons": [
		{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
		{ "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
		{ "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
	]
}
