# Self-hosted PeerJS signaling + TURN (see docs/tf).
# Copy to `.env` and fill in. `.env` is gitignored; Vite inlines VITE_* at BUILD
# time, so these values end up in the shipped bundle (the TURN credential is not
# a secret from the client — see docs/tf/NOTES.md). Leave blank to ship with only
# the public PeerJS cloud (the app still works; "default" mode just = public).

# Signaling server (Caddy terminates TLS in front of PeerServer).
# BLANK ON PURPOSE: filling this in points every build you make at somebody ELSE's
# box. Put your own host here, or leave it empty to use the public PeerJS cloud.
VITE_PEER_HOST=
VITE_PEER_PORT=443
VITE_PEER_PATH=/peerjs
VITE_PEER_SECURE=true
# VITE_PEER_KEY=            # only if the server sets a non-default --key

# ICE: comma-separated URLs. STUN is free/anonymous; TURN needs the credential.
VITE_STUN_URLS=stun:your-peerjs-host.example:3478
VITE_TURN_URLS=turn:your-peerjs-host.example:3478?transport=udp,turn:your-peerjs-host.example:3478?transport=tcp
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# CORS proxy chain for generated-asset CDNs that send no Access-Control-Allow-Origin
# (Meshy GLB downloads). Primary = the Cloudflare Worker (infra repo worker/,
# free tier, EC2-independent); the app automatically falls back to
# https://<VITE_PEER_HOST>/proxy (the peerjs box route) if the Worker is gone or
# over quota, and the DEV server serves its own same-origin /proxy.
VITE_ASSET_PROXY=https://proxy.theprototype.app

# --- local development conveniences -----------------------------------------
# Skip the first-run welcome overlay entirely. For a dev server you open fifty
# times a day; it changes nothing about what ships.
VITE_SKIP_WELCOME=false
